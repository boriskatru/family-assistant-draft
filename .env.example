# Generate .env with: python3 scripts/generate_env.py
COMPOSE_PROJECT_NAME=family-assistant
APP_VERSION=agent-draft
DEBUG=0
DJANGO_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
POSTGRES_USER=family
POSTGRES_DB=family
POSTGRES_PASSWORD=

TELEGRAM_BOT_TOKEN=
# Two numeric Telegram user IDs, separated by comma; never @usernames.
ALLOWED_TELEGRAM_IDS=
USER_NAMES=Борис,Анна
# Optional private family group numeric ID, typically negative. Empty = no group.
SHARED_CHAT_ID=
# One allowed user's personal Telegram ID; empty disables error DMs.
ERROR_ADMIN_TELEGRAM_ID=
# Suppress repeated alerts with the same cause within this window.
ERROR_ALERT_COOLDOWN_SECONDS=600
TELEGRAM_WEBHOOK_SECRET=
TIME_ZONE=Europe/Moscow

# Optional language model; commands work when these are empty.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# Empty uses the provider default for the primary agent model.
LLM_REASONING_EFFORT=
# Native OpenAI prompt cache on supported models: 30m or 12h.
LLM_PROMPT_CACHE_TTL=30m
# Optional audio model. Provider must support the transcription endpoint.
LLM_TRANSCRIPTION_MODEL=
# Empty uses LLM_MODEL. The selected model must support the uploaded images/PDFs.
LLM_DOCUMENT_MODEL=
LLM_STRUCTURED_MAX_OUTPUT_TOKENS=4000
MAX_UPLOAD_MB=15

# Agent SDK loop. Existing explicit Telegram commands still work without LLM.
AGENT_ENABLED=1
# personal = autonomous permitted actions; read_only = agent cannot mutate data.
AGENT_AUTONOMY=personal
# User turns per model input, including the current request; positive integer.
# Group history includes both spouses. The total token budget still applies.
AGENT_HISTORY_USER_LIMIT=50
# Turns per SDK batch; bounded continuations retain tool results and receipts.
AGENT_MAX_TURNS=12
AGENT_MAX_CONTINUATIONS=2
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_EXTERNAL_CALLS=8
AGENT_TIMEOUT_SECONDS=180
# Per-model-request timeout and network retries (0 disables retries).
AGENT_MODEL_TIMEOUT_SECONDS=90
AGENT_MODEL_RETRIES=2
AGENT_MAX_OUTPUT_TOKENS=2000
AGENT_MAX_TOTAL_TOKENS=80000

# Optional server-only family profile. Empty or missing file = built-in prompt.
# The file is read again for every new model run; no rebuild after editing it.
PERSONAL_CONTEXT_FILE=/app/private/personal_context.md
PERSONAL_CONTEXT_MAX_CHARS=20000
# 1 includes this SAME family profile in the configured shared Telegram chat.
PERSONAL_CONTEXT_IN_GROUPS=0

# Web search: Brave when its key is set, otherwise native OpenAI web search.
BRAVE_SEARCH_API_KEY=
# Empty uses LLM_MODEL; selected model must support native web_search.
LLM_WEB_SEARCH_MODEL=
LLM_WEB_SEARCH_MAX_OUTPUT_TOKENS=1800
# Google Maps Platform: enable Places API (New) + Routes API separately.
GOOGLE_MAPS_API_KEY=

# Optional Google Calendar + Meet; requires HTTPS callback (web profile).
PUBLIC_HOST=localhost
PUBLIC_BASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
